# Copy this file to .env and fill in real values. Never commit the real .env file.

APP_NAME="PhysioWeb Clinic"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata
APP_KEY=change-this-to-a-random-32-byte-value-before-deploying

# Database (MySQL 8+). For local smoke-testing without a MySQL server, the test
# harness in tests/ uses DB_DRIVER=sqlite with an in-memory database instead.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=physioweb
DB_USERNAME=physioweb_user
DB_PASSWORD=change-this-password

# Session
SESSION_LIFETIME_MINUTES=30
SESSION_NAME=physioweb_session

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8

# Mail (SMTP) - used by App\Core\Mailer (PHPMailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=change-this-password
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME="PhysioWeb Clinic"

# WhatsApp Business API (integration-ready; no default provider configured).
# Supported WHATSAPP_PROVIDER values implemented in App\Services\NotificationService:
#   "none"  - disabled (default)
#   "meta"  - Meta/WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS Gateway (integration-ready; no default provider configured).
# Supported SMS_PROVIDER values implemented in App\Services\NotificationService:
#   "none"  - disabled (default)
#   "generic_http" - any gateway exposing a simple HTTP GET/POST send endpoint
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# File uploads
UPLOAD_MAX_SIZE_MB=10
